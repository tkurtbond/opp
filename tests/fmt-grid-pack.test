# --align const,type,var with --pack: declarations in a grid of straight
# columns, broken by blank lines, leading comments and comments inside a
# declaration; a trailing comment ends its row, and a record has a row of
# its own.
program Opp
arg -p
arg -w
arg 72
arg --align
arg const,type,var
arg tests/data/fmt-grid.Mod
status 0
output
MODULE Grid; (* declarations that --align lines up in a grid *)

  CONST one = 1; two = 2;

  CONST
    eof    = 0;  ident     = 1;  number = 2; string  = 3; lparen = 4;
    rparen = 5;  semicolon = 6;  colon  = 7; becomes = 8; period = 9;
    comma  = 10; bar       = 11;

    (* widths *)
    maxWidth     = 1000; minWidth = 20;
    defaultWidth = 80; (* the default *)
    tab          = 9X;   nl       = 0AX;
    first        = 1; (* a comment *)
    second       = 2;    third    = 3;
    sum = 1 + (* in the expression *) 2;
    x      = 4; y       = 5;
    long* = "a string long enough that it should be on a line of its own";
    short- = 6; shorter = 7;

  CONST (* rows as the author has them *)
    red   = 0; green = 1; blue = 2; cyan = 3; magenta = 4; yellow = 5;
    black = 6; white = 7;

  TYPE
    Node = POINTER TO NodeDesc;
    NodeDesc = RECORD
      key: INTEGER;
      left, right: Node
    END;
    Name = ARRAY 32 OF CHAR;    Proc = PROCEDURE (n: Node); Set* = SET;
    Int  = INTEGER;             Long = LONGINT; (* sizes *)

  VAR
    i, j, k: INTEGER;      ch:   CHAR; done:   BOOLEAN; name: Name;
    root:    Node;         x, y: REAL; count-: LONGINT; w*:   Long;
    z:       INTEGER := 0;
    aVeryLongName, anotherVeryLongName, yetAnotherName,
    andOneMore: LONGINT;
    a, b:    CHAR;

  PROCEDURE P;
    CONST
      a      = 1;      bb = 22; ccc = 333; dddd = 4444; eeeee = 55555;
      ffffff = 666666;
  END P;

END Grid.
