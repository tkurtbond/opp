# With no files, opp formats its standard input.
program Opp
input tests/data/fmt-statements.Mod
status 0
output
MODULE Statements;
  PROCEDURE P(x: INTEGER; p: Node);
    VAR
      i, n: INTEGER;
      done: BOOLEAN;
  BEGIN
    i := 0;
    n := 10;
    INC(i);
    Out.Int(i, 0);
    Out.Ln;
    IF x > 0 THEN
      i := 1
    END;
    IF x > 0 THEN
      i := 1
    ELSIF x < 0 THEN
      i := -1
    ELSE
      i := 0
    END;
    IF (x > 0) & (n > 0) THEN
      i := 1;
      n := 2
    END;
    WHILE i < n DO
      INC(i)
    END;
    REPEAT
      DEC(i)
    UNTIL i = 0;
    FOR i := 0 TO n - 1 BY 2 DO
      Out.Int(i, 0)
    END;
    LOOP
      INC(i);
      IF i > n THEN
        EXIT
      END
    END;
    CASE x OF
      0: i := 0
    | 1, 2:
        i := 1;
        n := 2
    | 3..5:
        IF n > 0 THEN
          i := 3
        END
    ELSE i := -1
    END;
    WITH p: Leaf DO
      i := p.value
    END;
    WITH p: Leaf DO
      i := p.value
    | p: Inner DO
      i := 0
    ELSE
      i := -1
    END;
    p.left(Inner).right := NIL;
    p(Leaf).value := 3;
    IF done THEN
      RETURN
    END
  END P;
END Statements.
