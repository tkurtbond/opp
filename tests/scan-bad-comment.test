# An unterminated comment: the error is where it starts; exit 1.
program Opp
arg --tokens
arg tests/data/scan-bad-comment.Mod
status 1
output
1:1 keyword MODULE
1:8 identifier BadComment
1:18 symbol ;
  lead 2:3 newline multiline (* never (* closed *)\nEND BadComment.\n
4:1 end of text
tests/data/scan-bad-comment.Mod:2:3: unterminated comment
