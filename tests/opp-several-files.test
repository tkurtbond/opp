# Several files are formatted to standard output in turn; one that
# cannot be read or has a syntax error is reported and the rest are
# still formatted, with exit status 1.
program Opp
arg tests/data/formatted.Mod
arg tests/data/no-such-file.Mod
arg tests/data/fmt-error-string.Mod
arg tests/data/fmt-poc-extensions.Mod
status 1
output
MODULE Statements;
  PROCEDURE P(x: INTEGER; p: Node);
    VAR
      i, n: INTEGER;
      done: BOOLEAN;
  BEGIN
    i := 0;
    n := 10;
    INC(i);
    Out.Int(i, 0);
    Out.Ln;
    IF x > 0 THEN
      i := 1
    END;
    IF x > 0 THEN
      i := 1
    ELSIF x < 0 THEN
      i := -1
    ELSE
      i := 0
    END;
    IF (x > 0) & (n > 0) THEN
      i := 1;
      n := 2
    END;
    WHILE i < n DO
      INC(i)
    END;
    REPEAT
      DEC(i)
    UNTIL i = 0;
    FOR i := 0 TO n - 1 BY 2 DO
      Out.Int(i, 0)
    END;
    LOOP
      INC(i);
      IF i > n THEN
        EXIT
      END
    END;
    CASE x OF
      0: i := 0
    | 1, 2:
        i := 1;
        n := 2
    | 3..5:
        IF n > 0 THEN
          i := 3
        END
    ELSE i := -1
    END;
    WITH p: Leaf DO
      i := p.value
    END;
    WITH p: Leaf DO
      i := p.value
    | p: Inner DO
      i := 0
    ELSE
      i := -1
    END;
    p.left(Inner).right := NIL;
    p(Leaf).value := 3;
    IF done THEN
      RETURN
    END
  END P;
END Statements.
opp: cannot open tests/data/no-such-file.Mod
tests/data/fmt-error-string.Mod:3:8: unterminated string
MODULE PocExtensions;
  IMPORT SYSTEM;
  CONST
    SS$_NORMAL = 1;
    IO$_READVBLK = 49;
    origin = Point{x := 0, y := 0};
  TYPE
    Point = RECORD
      x, y: INTEGER := 0
    END;
    Vector = ARRAY 3 OF INTEGER;
  VAR
    count, total: INTEGER := 0;
    v: Vector;
  PROCEDURE ["C"] malloc(size: SYSTEM.ADDRESS): SYSTEM.ADDRESS;
  PROCEDURE ["C", "write"] Write*(fd: INTEGER; buf: SYSTEM.ADDRESS;
                                  n: SYSTEM.ADDRESS): SYSTEM.ADDRESS;

  PROCEDURE Show(s-: ARRAY OF CHAR; p-: Point);
  BEGIN
    ASSERT(s[0] # 0X, 20)
  END Show;

  CONST late = 2;
  VAR p: Point;
BEGIN
  p := Point{x := 1, y := 2};
  v := Vector{1, 2, 3};
  v := Vector{[0..1]: 7, [2]: 9};
  p := Point{x := late, y := count}
END PocExtensions.
