# At width 40, a first statement that does not fit on BEGIN's line goes on
# the next, and END goes on its own line when the whole does not fit.
program Opp
arg -w
arg 40
arg tests/data/fmt-cuddle.Mod
status 0
output
MODULE Cuddle; (* bodies on BEGIN's line, and END on it too *)

  VAR count: INTEGER;

  PROCEDURE Get(): INTEGER;
  BEGIN RETURN count END Get;

  PROCEDURE Inc;
  BEGIN INC(count)
  END Inc;

  PROCEDURE Reset;
  BEGIN
    count := 0
  END Reset;

  PROCEDURE Twice;
  BEGIN Inc;
    Inc
  END Twice;

  PROCEDURE Long(
      a, b, c: INTEGER): INTEGER;
  BEGIN
    RETURN a * 1000 + b * 100 + c * 10
        + count * count
  END Long;

  PROCEDURE Check(x: INTEGER);
  BEGIN
    IF x > 0 THEN
      Inc
    ELSE
      Reset
    END
  END Check;

BEGIN count := 0 END Cuddle.
