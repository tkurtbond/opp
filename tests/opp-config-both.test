# The current directory's .opp.conf is read after the user's, and wins:
# --keep-lines over --pack, --case-bar drop, and --align nocomment on top of
# the user's all.
program Opp
arg ../../fmt-align.Mod
env XDG_CONFIG_HOME=../user
dir tests/data/config/project
status 0
output
MODULE Align; (* columns an author lines up *)

CONST
  null   = 0;  times  = 1;  slash = 2;
  plus   = 6;  minus  = 7;  eql   = 9;
  maxIdentLen = 32; (* the longest identifier *)
  maxStrLen   = 256; (* the longest string *)

TYPE
  Item = RECORD
    kind:  INTEGER; (* what the item is *)
    value: LONGINT; (* its value, if a constant *)
    next:  POINTER TO Item
  END;

VAR
  count: INTEGER; (* items seen *)
  total: LONGINT; (* their sum, which can be much longer than anything the line can hold *)

TYPE
  Point  = RECORD
    x, y:   INTEGER := 0;
    name:   ARRAY 16 OF CHAR;
    weight: REAL    := 1.0
  END;
  Vector = ARRAY 3 OF INTEGER;

VAR
  origin: Point;
  limit:  INTEGER := 100;
  scale:  REAL    := 2.5; (* poc's initializers *)

PROCEDURE Sym(ch: CHAR): INTEGER;
  VAR s: INTEGER;
BEGIN
  CASE ch OF
    "*": s := times
  | "/": s := slash
  | "+": s := plus
  | "-": s := minus
  ELSE   s := null
  END;
  count := count   + 1;
  RETURN s
END Sym;

END Align.
