# A string ends at its line: unterminated; exit 1.
program Opp
arg --tokens
arg tests/data/scan-bad-string.Mod
status 1
output
1:1 keyword MODULE
1:8 identifier BadString
1:17 symbol ;
2:3 keyword CONST
2:9 identifier s
2:11 symbol =
2:13 string "open
3:1 keyword END
3:5 identifier BadString
3:14 symbol .
4:1 end of text
tests/data/scan-bad-string.Mod:2:13: unterminated string
